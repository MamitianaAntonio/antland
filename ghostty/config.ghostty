# Font
font-family = "Mononoki Nerd Font"
font-size = 13

# Cursor
cursor-style = block_hollow

# Window
window-padding-x = 10
window-padding-y = 10

# Colors
theme = Catppuccin Mocha

# Cursor colors
cursor-color = #528bff
cursor-text = #282c34

# Set transparency lower than 1.0
background-opacity = 0.55

# Enable background blur
background-blur = true

