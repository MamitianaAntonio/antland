{
  "layer": "top",
  "position": "top",
  "height": 42,
  "spacing": 2,
  "exclusive": true,
  "gtk-layer-shell": true,
  "passthrough": false,
  "fixed-center": true,
  "margin-top": 2,
  "margin-left": 2,
  "margin-right": 2,
  "padding": 3,

  "modules-left": [
    "custom/logo",
    "custom/sep",
    "hyprland/window",
    "hyprland/workspaces",
    "mpris"
  ],

  "modules-right": [
    "cpu",
    "memory",
    "custom/sep",
    "network",
    "tray",
    "battery",
    "pulseaudio",
    "clock#date",
    "clock",
    "custom/sep",
    "custom/theme",
    "custom/power"
  ],

  "custom/logo": {
    "format": "🐧",
    "tooltip": false,
    "on-click": "rofi -show drun"
  },

  "custom/theme": {
    "format": "󰔎",
    "tooltip": true,
    "tooltip-format": "Toggle dark/light",
    "on-click": "bash ~/.config/waybar/scripts/waybar-theme-toggle.sh"
  },

  "hyprland/window": {
    "format": "󰖲 {}",
    "max-length": 40,
    "rewrite": {
      ".*Mozilla Firefox.*": "Firefox",
      ".*Neovim.*": "Neovim",
      ".*Code.*": "VS Code"
    }
  },

  "hyprland/workspaces": {
    "on-click": "activate",
    "format": "{id}",
    "all-outputs": true,
    "disable-scroll": false
  },

  "mpris": {
    "format": "󰝚 {title}",
    "format-paused": "󰏤 {title}",
    "format-stopped": "",
    "max-length": 30
  },

  "cpu": {
    "format": "󰻠 {usage}%",
    "interval": 2
  },

  "memory": {
    "format": "󰍛 {used:0.1f}G"
  },

  "network": {
    "format-wifi": "󰤨 {essid}",
    "format-ethernet": "󰈀 eth",
    "format-disconnected": "󰤭 off",
    "tooltip-format-wifi": "{signalStrength}% — {ipaddr}",
    "on-click": "nm-connection-editor"
  },

  "battery": {
    "format": "󰁹 {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "states": {
      "warning": 30,
      "critical": 15
    }
  },

  "pulseaudio": {
    "format": "󰕾 {volume}%",
    "format-muted": "󰖁 muted",
    "on-click": "pavucontrol"
  },

  "clock#date": {
    "format": "󰅸 {:%a %d %b}"
  },

  "clock": {
    "format": "{:%H:%M}"
  },

  "custom/sep": {
    "format": "•",
    "tooltip": false
  },

  "custom/power": {
    "format": "⏻",
    "on-click": "wlogout"
  }
}
